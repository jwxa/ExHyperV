<Page x:Class="ExHyperV.Views.HostConnectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
      Title="主机连接">
    <Page.Resources>
        <Style x:Key="HostListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Width="174" Height="82"
                                Padding="12,10"
                                CornerRadius="6"
                                Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{ui:ThemeResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChannelPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ui:ThemeResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ui:ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="PreflightStepPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{ui:ThemeResource ControlFillColorSecondaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PreflightStepNumberStyle" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{ui:ThemeResource CardStrokeColorDefaultBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PreflightStepNumberTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PreflightAccountListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Padding="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{ui:ThemeResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{ui:ThemeResource ControlFillColorSecondaryBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush"
                                        Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition x:Name="HostStripRow" Height="126"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ui:TextBlock Text="主机连接" FontSize="28"
                              Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="管理本机与局域网中的 Hyper-V 主机"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Command="{Binding OpenLogsCommand}" Appearance="Secondary" Margin="0,0,8,0"
                           ToolTip="打开 ExHyperV 日志目录"
                           Content="日志" Icon="DocumentBulletList24"/>
                <ui:Button Command="{Binding AddHostCommand}" Appearance="Primary"
                           Content="添加主机" Icon="Add24"/>
            </StackPanel>
        </Grid>

        <!-- 布局 B：桌面端固定 126px 横向主机条。 -->
        <Border Grid.Row="2"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10">
            <Grid x:Name="HostStripGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="172"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="ActiveHostPanel" VerticalAlignment="Center" Margin="2,0,10,0">
                    <TextBlock Text="当前活动主机" FontSize="12"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding ActiveHostName}" FontWeight="SemiBold" FontSize="16" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ActiveHostAddress}" FontSize="12" Margin="0,2,0,0"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="7" Height="7" Fill="{Binding ActiveHostStatusBrush}"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ActiveHostStatus}" FontSize="12"
                                   Foreground="{Binding ActiveHostStatusBrush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ActiveHostIdentity}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ActiveHostSnapshot}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <ListBox x:Name="HostList" Grid.Column="1"
                         ItemsSource="{Binding Hosts}"
                         SelectedItem="{Binding SelectedHost, Mode=TwoWay}"
                         IsEnabled="{Binding IsSwitching, Converter={StaticResource InverseBooleanConverter}}"
                         ItemContainerStyle="{StaticResource HostListItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         BorderThickness="0" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6"
                                        Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                                        VerticalAlignment="Top">
                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Address}" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{Binding StateBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ui:Button x:Name="AddHostTile" Grid.Column="2" Command="{Binding AddHostCommand}" Appearance="Secondary"
                           Width="108" Height="82" Margin="8,0,0,0" ToolTip="添加局域网主机"
                           Content="添加主机" Icon="AddCircle24"/>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="DetailHeaderGrid" Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="8"
                                Background="{ui:ThemeResource ControlFillColorSecondaryBrush}">
                            <ui:SymbolIcon Symbol="Server24" FontSize="20"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedDisplayName}" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedAddress}" Margin="0,3,0,0"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="DetailActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Command="{Binding EditSelectedHostCommand}"
                                   IsEnabled="{Binding IsRemoteSelected}" Appearance="Secondary"
                                   ToolTip="编辑主机配置" Width="36" Height="36" Padding="0" Margin="0,0,6,0">
                            <ui:SymbolIcon Symbol="Edit24"/>
                        </ui:Button>
                        <ui:Button Command="{Binding DeleteSelectedHostCommand}"
                                   IsEnabled="{Binding IsRemoteSelected}" Appearance="Secondary"
                                   ToolTip="删除主机配置" Width="36" Height="36" Padding="0" Margin="0,0,8,0">
                            <ui:SymbolIcon Symbol="Delete24"/>
                        </ui:Button>
                        <ui:Button Command="{Binding DiagnoseSelectedHostCommand}"
                                   IsEnabled="{Binding IsRemoteSelected}" Appearance="Secondary" Margin="0,0,8,0">
                            <ui:Button.Content>重新检测</ui:Button.Content>
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Pulse24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Command="{Binding OpenPreflightCommand}"
                                   IsEnabled="{Binding IsRemoteSelected}" Appearance="Secondary" Margin="0,0,8,0">
                            <ui:Button.Content>配置预检</ui:Button.Content>
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ShieldTask24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Command="{Binding ConnectToSelectedHostCommand}"
                                   IsEnabled="{Binding CanExecuteConnectionAction}"
                                   Appearance="{Binding ConnectionActionAppearance}"
                                   Foreground="White"
                                   ToolTip="{Binding ConnectionActionToolTip}" ToolTipService.ShowOnDisabled="True">
                            <StackPanel Orientation="Horizontal">
                                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,7,0"
                                                 Visibility="{Binding IsSwitching, Converter={StaticResource BoolToVis}}"/>
                                <ui:SymbolIcon Symbol="PlugConnected24" Margin="0,0,7,0"
                                               Visibility="{Binding IsSwitching, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                <TextBlock Text="{Binding ConnectionActionText}"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                        Visibility="{Binding IsReconnectVisible, Converter={StaticResource BoolToVis}}"
                        Background="{ui:ThemeResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{ui:ThemeResource SystemFillColorCautionBrush}" BorderThickness="1">
                    <Grid x:Name="ReconnectBannerGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="ArrowSync24" Foreground="{ui:ThemeResource SystemFillColorCautionBrush}"
                                       FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="连接已中断 · 当前为旧数据" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ReconnectSummary}" FontSize="12" Margin="0,3,12,0" TextWrapping="Wrap"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel x:Name="ReconnectActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="立即重试" Command="{Binding RetryReconnectCommand}" Appearance="Primary" Icon="ArrowSync24" Margin="0,0,8,0"/>
                            <ui:Button Content="停止重连" Command="{Binding StopReconnectCommand}" Appearance="Secondary" Icon="Dismiss24"
                                       Visibility="{Binding IsReconnectActive, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TabControl Grid.Row="2" BorderThickness="0" Background="Transparent"
                            SelectedIndex="{Binding SelectedWorkspaceTabIndex, Mode=TwoWay}">
                    <TabItem Header="概览">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,6,0">
                            <StackPanel>
                                <Border Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Info24" FontSize="20" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DiagnosticSummary}" TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Grid x:Name="ChannelGrid">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="240"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*" MinWidth="240"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ManagementPanel" Style="{StaticResource ChannelPanelStyle}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Server24" Margin="0,0,8,0"/>
                                                    <StackPanel>
                                                        <TextBlock Text="WMI / DCOM" FontWeight="SemiBold"/>
                                                        <TextBlock Text="Hyper-V 管理通道" FontSize="12"
                                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Grid Width="16" Height="16" Margin="0,0,6,0">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding ManagementStatusBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Visibility="{Binding ManagementStatusUsesDot, Converter={StaticResource BoolToVis}}"/>
                                                        <ui:FontIcon Glyph="{Binding ManagementStatusGlyph}" FontSize="16"
                                                                     FontFamily="{DynamicResource SegoeFluentIcons}"
                                                                     Foreground="{Binding ManagementStatusBrush}"
                                                                     Visibility="{Binding ManagementStatusUsesDot, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ManagementStatus}" FontWeight="SemiBold"
                                                               Foreground="{Binding ManagementStatusBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding ManagementDetail}" TextWrapping="Wrap" Margin="0,14,0,0"
                                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="ConsolePanel" Grid.Column="2" Style="{StaticResource ChannelPanelStyle}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,8,0"/>
                                                    <StackPanel>
                                                        <TextBlock Text="TCP 2179" FontWeight="SemiBold"/>
                                                        <TextBlock Text="虚拟机控制台通道" FontSize="12"
                                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Grid Width="16" Height="16" Margin="0,0,6,0">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding ConsoleStatusBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                 Visibility="{Binding ConsoleStatusUsesDot, Converter={StaticResource BoolToVis}}"/>
                                                        <ui:FontIcon Glyph="{Binding ConsoleStatusGlyph}" FontSize="16"
                                                                     FontFamily="{DynamicResource SegoeFluentIcons}"
                                                                     Foreground="{Binding ConsoleStatusBrush}"
                                                                     Visibility="{Binding ConsoleStatusUsesDot, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ConsoleStatus}" FontWeight="SemiBold"
                                                               Foreground="{Binding ConsoleStatusBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding ConsoleDetail}" TextWrapping="Wrap" Margin="0,14,0,0"
                                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid x:Name="IdentityPropertyGrid" Margin="0,18,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="连接身份" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedIdentity}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="凭据存储" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding SelectedCredentialStorage}" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="连接诊断">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="检测 IPv4、身份、WMI/DCOM 和 TCP 2179；失败步骤不会掩盖独立通道结果。"
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:Button Command="{Binding CancelDiagnosticsCommand}"
                                               Visibility="{Binding IsDiagnosing, Converter={StaticResource BoolToVis}}"
                                               Appearance="Secondary" Content="取消" Margin="0,0,8,0"/>
                                    <ui:Button Command="{Binding DiagnoseSelectedHostCommand}"
                                               IsEnabled="{Binding IsRemoteSelected}" Appearance="Primary">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,7,0"
                                                             Visibility="{Binding IsDiagnosing, Converter={StaticResource BoolToVis}}"/>
                                            <ui:SymbolIcon Symbol="Pulse24" Margin="0,0,7,0"
                                                           Visibility="{Binding IsDiagnosing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                            <TextBlock Text="开始检测"/>
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="DiagnosticContentGrid" Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="300"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="3*" MinWidth="360"/>
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="DiagnosticStepsList" ItemsSource="{Binding DiagnosticSteps}" BorderThickness="1"
                                         BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                         Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Visibility="{Binding StatusUsesDot, Converter={StaticResource BoolToVis}}"/>
                                                    <ui:FontIcon Glyph="{Binding StatusIconGlyph}" Foreground="{Binding StatusBrush}"
                                                                 FontFamily="{DynamicResource SegoeFluentIcons}" FontSize="16"
                                                                 Visibility="{Binding StatusUsesDot, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                                </Grid>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Explanation}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,8,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Duration}" FontSize="11" HorizontalAlignment="Right"
                                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border x:Name="DiagnosticLogPanel" Grid.Column="2" Background="#0C0C0C" CornerRadius="4" Padding="12">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding DiagnosticLogText}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="#D0D0D0" TextWrapping="NoWrap"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="配置预检">
                        <Grid Margin="0,14,0,0" DataContext="{Binding Preflight}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="远程连接配置预检" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding HostLabel}" Margin="0,3,0,0"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:Button Grid.Column="1" Command="{Binding RunCommand}" Appearance="Secondary">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,7,0"
                                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                        <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,7,0"
                                                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                        <TextBlock Text="重新检测"/>
                                    </StackPanel>
                                </ui:Button>
                            </Grid>

                            <Grid x:Name="PreflightContentGrid" Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="PreflightStepSidebar"
                                        Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10">
                                    <ItemsControl ItemsSource="{Binding Steps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource PreflightStepPanelStyle}" Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Style="{StaticResource PreflightStepNumberStyle}">
                                                            <TextBlock Text="{Binding Number}" Style="{StaticResource PreflightStepNumberTextStyle}"/>
                                                        </Border>
                                                        <StackPanel Margin="9,0,0,0">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Detail}" FontSize="11"
                                                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Border x:Name="PreflightStepStrip" Grid.ColumnSpan="3" Visibility="Collapsed"
                                        Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="5">
                                    <ItemsControl ItemsSource="{Binding Steps}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" Columns="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource PreflightStepPanelStyle}" Padding="6">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Border Style="{StaticResource PreflightStepNumberStyle}" Width="22" Height="22" CornerRadius="11">
                                                            <TextBlock Text="{Binding Number}" FontSize="11"
                                                                       Style="{StaticResource PreflightStepNumberTextStyle}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11"
                                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Grid x:Name="PreflightStepBody" Grid.Column="2">
                                    <Grid Visibility="{Binding IsDetectStep, Converter={StaticResource BoolToVis}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="2*"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="3*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="Info24" Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                                               FontSize="18" Margin="0,0,9,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Summary}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                        <ListBox Grid.Row="2" ItemsSource="{Binding Findings}"
                                                 BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                 Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="8,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Width="16" Height="16">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                     Visibility="{Binding StatusUsesDot, Converter={StaticResource BoolToVis}}"/>
                                                            <ui:FontIcon Glyph="{Binding StatusIconGlyph}" Foreground="{Binding StatusBrush}"
                                                                         FontFamily="{DynamicResource SegoeFluentIcons}" FontSize="16"
                                                                         Visibility="{Binding StatusUsesDot, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" FontSize="12" Margin="0,2,12,0"
                                                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border Grid.Row="4" Background="#0C0C0C" CornerRadius="4" Padding="12">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding PreflightLogText}" FontFamily="Consolas" FontSize="12"
                                                           Foreground="#D0D0D0" TextWrapping="NoWrap"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>

                                    <ScrollViewer Visibility="{Binding IsAccountStep, Converter={StaticResource BoolToVis}}"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="选择允许远程管理的账户" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="仅建议加入 Hyper-V Administrators 与 Remote Management Users；不会授予 Administrators。"
                                                       TextWrapping="Wrap" Margin="0,4,0,14"
                                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                            <ListBox ItemsSource="{Binding LocalAccounts}" SelectedItem="{Binding SelectedLocalAccount}"
                                                     IsEnabled="{Binding UseDomainAccount, Converter={StaticResource InverseBooleanConverter}}"
                                                     ItemContainerStyle="{StaticResource PreflightAccountListItemStyle}"
                                                     BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                     Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="9,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="30" Height="30" CornerRadius="15" Background="{ui:ThemeResource ControlFillColorSecondaryBrush}">
                                                                <TextBlock Text="{Binding Name[0]}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                                <TextBlock Text="{Binding MembershipDetail}" FontSize="11" TextWrapping="Wrap" Margin="0,2,8,0"
                                                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="本地" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <CheckBox IsChecked="{Binding UseDomainAccount}" Content="改为手工指定域账户" Margin="0,14,0,8"/>
                                            <ui:TextBox Text="{Binding DomainAccountName, UpdateSourceTrigger=PropertyChanged}"
                                                        IsEnabled="{Binding UseDomainAccount}" PlaceholderText="DOMAIN\User 或 user@domain"/>
                                            <Border Background="{ui:ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                    BorderBrush="{ui:ThemeResource SystemFillColorCautionBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="12" Margin="0,14,0,0">
                                                <TextBlock Text="LocalAccountTokenFilterPolicy 只会在工作组、选中已存在本地管理员账户且策略缺失时进入修改预览。"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer Visibility="{Binding IsNetworkStep, Converter={StaticResource BoolToVis}}"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="选择目标网络与允许访问范围" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="多网卡场景必须明确选择；Public 网络是否改为 Private 由你决定。"
                                                       TextWrapping="Wrap" Margin="0,4,0,14"
                                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                            <ItemsControl ItemsSource="{Binding Networks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                                Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                                                                CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding AddressText}" FontSize="12" Margin="0,2,0,0"
                                                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding CategoryText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                                    <CheckBox IsChecked="{Binding MakePrivate}" IsEnabled="{Binding CanMakePrivate}"
                                                                              Content="确认改为 Private" Margin="12,4,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="允许的 IPv4 CIDR" FontWeight="SemiBold" Margin="0,10,0,7"/>
                                            <ItemsControl ItemsSource="{Binding DetectedCidrs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,0,7">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Cidr}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Source, StringFormat=  · {0}}" Margin="8,0,0,0"
                                                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="手工补充 CIDR" Margin="0,8,0,6"/>
                                            <ui:TextBox Text="{Binding ManualCidrs, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="例如 172.16.0.0/24；多项可用逗号或换行分隔"/>
                                            <TextBlock Text="仅接受 IPv4 CIDR。输入会规范化并去重；主机名、IPv6、非法或重复项会阻止生成预览。"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer x:Name="PreflightPreviewScrollViewer"
                                                  Visibility="{Binding IsPreviewStep, Converter={StaticResource BoolToVis}}"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="审查拟执行修改" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap" Margin="0,4,0,14"
                                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                            <ItemsControl ItemsSource="{Binding PlannedChanges}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                                Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                                                                CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="40"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Number}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                                                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="12" Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="ShieldCheckmark24"
                                                                   Foreground="{ui:ThemeResource SystemAccentColorPrimaryBrush}"
                                                                   Margin="0,0,9,0"/>
                                                    <TextBlock Text="应用前会重新检测；只有输入精确“确认”才执行。每步验证后生成只撤销本次修改的回滚脚本。"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0"
                                                    Visibility="{Binding HasApplyResult, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ApplySummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <ItemsControl ItemsSource="{Binding ApplySteps}" Margin="0,8,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                                                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                                               FontWeight="SemiBold" Margin="12,0,0,0"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Grid Margin="0,6,0,0"
                                                          Visibility="{Binding RollbackScriptPath, Converter={StaticResource StringToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding RollbackScriptPath, StringFormat=回滚脚本：{0}}"
                                                                   TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                                                                   VerticalAlignment="Center"/>
                                                        <ui:Button Grid.Column="1" Width="32" Height="32" Padding="0" Margin="8,0,0,0"
                                                                   Icon="{ui:SymbolIcon Symbol=FolderOpen24, FontSize=16}"
                                                                   ToolTip="在资源管理器中定位回滚脚本"
                                                                   Command="{Binding DataContext.RevealRollbackScriptCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                   CommandParameter="{Binding RollbackScriptPath}"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding RollbackInstruction}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                                               Foreground="{ui:ThemeResource SystemFillColorCautionBrush}"
                                                               Visibility="{Binding RollbackInstruction, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                    <Border Background="#0C0C0C" CornerRadius="4" Padding="9" Margin="0,8,0,0"
                                                            Visibility="{Binding ApplyLogText, Converter={StaticResource StringToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding ApplyLogText}" Foreground="#D0D0D0" FontFamily="Consolas"
                                                                   FontSize="11" TextWrapping="Wrap"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectionError}" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:Button Content="上一步" Command="{Binding PreviousStepCommand}" Appearance="Secondary" Margin="0,0,8,0"/>
                                    <ui:Button Content="{Binding NextButtonText}" Command="{Binding NextStepCommand}" Appearance="Primary"
                                               Visibility="{Binding IsPreviewStep, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                    <ui:Button Command="{Binding DataContext.ApplyPreflightCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               IsEnabled="{Binding CanApply}" Appearance="Danger" Foreground="White"
                                               Visibility="{Binding IsPreviewStep, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,7,0"
                                                             Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}"/>
                                            <ui:SymbolIcon Symbol="Warning24" Margin="0,0,7,0"
                                                           Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                            <TextBlock Text="应用选中修改"/>
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="日志">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="实时日志" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="{Binding SelectedDisplayName}" Margin="0,3,0,0"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Width="34" Height="34" Padding="0" Margin="0,0,8,0"
                                               Command="{Binding Logs.ReturnToLatestCommand}"
                                               Visibility="{Binding Logs.IsFollowingLatest, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                               ToolTip="回到最新">
                                        <ui:SymbolIcon Symbol="ArrowDown24" FontSize="16"/>
                                    </ui:Button>
                                    <ui:Button Width="34" Height="34" Padding="0"
                                               Command="{Binding OpenLogsCommand}"
                                               ToolTip="打开日志目录">
                                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16"/>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2">
                                <ListView x:Name="LiveLogList"
                                          ItemsSource="{Binding Logs.Entries}"
                                          BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
                                          BorderThickness="1"
                                          Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          ScrollViewer.CanContentScroll="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.ScrollChanged="OnLiveLogScrollChanged">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="88"/>
                                                    <ColumnDefinition Width="54"/>
                                                    <ColumnDefinition Width="112"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" Fill="{Binding LevelBrush}"
                                                         HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TimestampText}"
                                                           FontFamily="Consolas" FontSize="11" VerticalAlignment="Top"
                                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding LevelText}"
                                                           Foreground="{Binding LevelBrush}" FontSize="12"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Source}" FontSize="12"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Source}"/>
                                                <StackPanel Grid.Column="4" Margin="4,0,12,0">
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap"
                                                               FontFamily="Consolas" FontSize="11" Margin="0,3,0,0"
                                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="5" Text="{Binding ErrorCategoryText}"
                                                           FontFamily="Consolas" FontSize="11"
                                                           Foreground="{Binding LevelBrush}"
                                                           Visibility="{Binding HasErrorCategory, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="当前宿主暂无日志。"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Logs.HasEntries, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Page>
