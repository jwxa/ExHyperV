<UserControl x:Class="ExHyperV.Views.HostConfigurationDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             MinWidth="520" MaxWidth="660" MaxHeight="560">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{ui:ThemeResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{ui:ThemeResource SystemFillColorCriticalBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Warning24" Foreground="{ui:ThemeResource SystemFillColorCriticalBrush}"
                               Margin="0,1,10,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="将修改远程主机系统配置" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TargetText}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding ChangeCountText}" Margin="0,2,0,0"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="已审查修改" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <ItemsControl ItemsSource="{Binding PlannedChanges}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" FontFamily="Consolas"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="输入精确的中文“确认”以允许修改" FontWeight="SemiBold" Margin="0,8,0,6"/>
                <ui:TextBox Text="{Binding ConfirmationText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="确认"/>
                <TextBlock Text="额外空格、繁体字、相似字符或其他文本均不能通过。"
                           FontSize="12" Margin="0,5,0,0"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
