<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <PackageReference Include="System.Management" Version="10.0.8" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <Compile Include="..\..\src\Services\Shared\Logging\*.cs" Link="Logging\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Services\Shared\AppDataPaths.cs" Link="Shared\AppDataPaths.cs" />
    <Compile Include="..\..\src\Services\Shared\SupportArtifactLocator.cs" Link="Shared\SupportArtifactLocator.cs" />
    <Compile Include="..\..\src\Services\Vm\VmLifecycleActionPolicy.cs" Link="Vm\VmLifecycleActionPolicy.cs" />
    <Compile Include="..\..\src\Services\Remote\Profiles\*.cs" Link="Profiles\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Services\Remote\Credentials\*.cs" Link="Credentials\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Services\Remote\Sessions\*.cs" Link="Sessions\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Services\Remote\Diagnostics\*.cs" Link="Diagnostics\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Services\Remote\Preflight\*.cs" Link="Preflight\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Services\Remote\Configuration\*.cs" Link="Configuration\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\ViewModels\HostPreflightViewModel.cs" Link="ViewModels\HostPreflightViewModel.cs" />
    <Compile Include="..\..\src\ViewModels\UiStatusBrushes.cs" Link="ViewModels\UiStatusBrushes.cs" />
    <Compile Include="..\..\src\ViewModels\HostConfigurationDialogViewModel.cs" Link="ViewModels\HostConfigurationDialogViewModel.cs" />
    <Compile Include="..\..\src\Services\Remote\Vms\*.cs" Link="RemoteVms\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Services\Remote\Consoles\*.cs" Link="RemoteConsoles\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Tools\Api\ApiResponse.cs" Link="Tools\ApiResponse.cs" />
    <Compile Include="..\..\src\Tools\Api\WmiApi.cs" Link="Tools\WmiApi.cs" />
    <Compile Include="..\ExHyperV.IntegrationTests\IntegrationOptions.cs" Link="Integration\IntegrationOptions.cs" />
    <Compile Include="..\ExHyperV.IntegrationTests\AcceptanceReport.cs" Link="Integration\AcceptanceReport.cs" />
    <Compile Include="..\ExHyperV.IntegrationTests\DisconnectAcceptanceObserver.cs" Link="Integration\DisconnectAcceptanceObserver.cs" />
    <Compile Include="..\ExHyperV.IntegrationTests\PartialAvailabilityAcceptance.cs" Link="Integration\PartialAvailabilityAcceptance.cs" />
  </ItemGroup>
</Project>
